# Copy to .env (gitignored) and edit. Every value is optional: the pipeline runs on its
# defaults, and credentials come from AzureOpeapiKeys.txt unless overridden here.
#
# Naming: SSI_<SECTION>__<FIELD>, matching src/ssi_extractor/config/settings.py.

# --- credentials -------------------------------------------------------------
# Override the values inside AzureOpeapiKeys.txt (Spring ${VAR:default} semantics).
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
# Point at a different credentials file (e.g. a Key Vault mount):
# SSI_AZURE_CREDENTIALS_FILE=/run/secrets/azure_openai.yaml

# --- model governance and cost control --------------------------------------
# SSI_LLM__PROVIDER=azure_openai          # or: anthropic
# SSI_LLM__TEMPERATURE=0.0                # dropped automatically if the deployment rejects it
# SSI_LLM__MAX_OUTPUT_TOKENS=16000
# SSI_LLM__MAX_CALLS_PER_CHUNK=3
# SSI_LLM__MAX_CALLS_PER_DOCUMENT=500
# SSI_LLM__REQUEST_TIMEOUT_SECONDS=120

# --- OCR ---------------------------------------------------------------------
# SSI_OCR__CONFIDENCE_TIER1=0.80          # below this, re-enhance aggressively and re-OCR once
# SSI_OCR__CONFIDENCE_FLOOR=0.60          # below this after the retry, a vision fallback is needed
# SSI_OCR__MAX_RETRIES=1

# --- privacy -----------------------------------------------------------------
# SSI_PRIVACY__EXTERNAL_FALLBACK_ENABLED=false   # keep false unless external calls are permitted
# SSI_PRIVACY__MASK_BEFORE_EXTERNAL_CALL=true
# SSI_PRIVACY__LOCAL_VISION_MODEL_SKIPS_MASKING=false
# SSI_PRIVACY__LOG_HASH_LENGTH=12

# --- confidence and review ---------------------------------------------------
# Weights must sum to 1.0 or startup fails.
# SSI_CONFIDENCE__WEIGHT_OCR=0.30
# SSI_CONFIDENCE__WEIGHT_LLM=0.30
# SSI_CONFIDENCE__WEIGHT_FORMAT=0.25
# SSI_CONFIDENCE__WEIGHT_REFERENCE=0.15
# SSI_CONFIDENCE__REVIEW_FLOOR=0.70

# --- input gate --------------------------------------------------------------
# SSI_INPUT_GATE__MAX_FILE_BYTES=209715200
# SSI_INPUT_GATE__MAX_PAGES=1000
# SSI_INPUT_GATE__PER_PAGE_TIMEOUT_SECONDS=30

# --- logging and audit -------------------------------------------------------
# SSI_LOGGING__LEVEL=INFO                 # DEBUG for stage-by-stage detail
# SSI_LOGGING__REDACT=true                # never set false outside a local investigation
# SSI_AUDIT__ENABLED=true
